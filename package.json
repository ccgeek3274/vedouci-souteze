{
  "name": "vedouci-souteze",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n worker,web \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply vedouci-souteze-db --local",
    "db:seed:local": "wrangler d1 execute vedouci-souteze-db --local --file=scripts/dev-seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply vedouci-souteze-db --remote"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.75.0",
    "hono": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.14.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261006.1": true
  }
}
